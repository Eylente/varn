<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Varn.Desktop.App"
             xmlns:local="using:Varn.Desktop"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>
    
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Varn.Desktop/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark"
                                       Accent="#FFB020"
                                       RegionColor="#0B0F18"
                                       ErrorText="#FF5C7C" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Varn.Desktop/Styles/Theme.axaml" />
    </Application.Styles>
</Application>